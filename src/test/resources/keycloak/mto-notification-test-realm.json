{
  "realm": "mto",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      {
        "name": "notification-admin",
        "description": "Homonimo a proposito de un permiso de cliente: sirve para comprobar que un rol de realm NO concede el permiso del mismo nombre."
      },
      {
        "name": "mto-notification-auditor",
        "description": "Perfil compuesto: la bandeja, el registro y los accesos.",
        "composite": true,
        "composites": {
          "client": {
            "mto-notification-api": [
              "notification-inbox",
              "notification-activity-read",
              "notification-access-read"
            ]
          }
        }
      },
      {
        "name": "mto-notification-admin",
        "description": "Perfil compuesto con los cuatro permisos.",
        "composite": true,
        "composites": {
          "client": {
            "mto-notification-api": [
              "notification-inbox",
              "notification-activity-read",
              "notification-access-read",
              "notification-admin"
            ]
          }
        }
      }
    ],
    "client": {
      "mto-notification-api": [
        {
          "name": "notification-inbox"
        },
        {
          "name": "notification-activity-read"
        },
        {
          "name": "notification-access-read"
        },
        {
          "name": "notification-admin"
        },
        {
          "name": "ops-metrics"
        },
        {
          "name": "ops-write"
        }
      ]
    }
  },
  "clients": [
